# Grafana Cloud credentials for Alloy. Copy to .env (git-ignored) and fill in.
# Prometheus: Grafana Cloud portal -> your stack -> Prometheus -> Details
GRAFANA_PROM_URL=
GRAFANA_PROM_USER=
# Loki: Grafana Cloud portal -> your stack -> Loki -> Details
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
# An access policy token with metrics:write and logs:write
GRAFANA_TOKEN=
