# Grafana Cloud credentials for Alloy. Copy to .env (git-ignored) and fill in.
# Prometheus: Grafana Cloud portal -> your stack -> Prometheus -> Details
# Full remote-write URL, e.g. https://prometheus-prod-NN-prod-REGION.grafana.net/api/prom/push
GRAFANA_PROM_URL=
GRAFANA_PROM_USER=
# Loki: Grafana Cloud portal -> your stack -> Loki -> Details
# The Details page shows only the base URL; append /loki/api/v1/push (a 405 error means it's missing),
# e.g. https://logs-prod-NNN.grafana.net/loki/api/v1/push
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
# An access policy token with metrics:write and logs:write
GRAFANA_TOKEN=
