{
  "title": "chase: dog barking",
  "uid": "chase-barking",
  "tags": [
    "chase"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Barking right now",
      "description": "Length of barking in progress, and time left until it counts as an episode.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "chase_current_run_seconds",
          "legendFormat": "barking",
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "chase_seconds_until_episode",
          "legendFormat": "until it counts",
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Barks this hour",
      "description": "Estimated barks this local hour vs the 30-day average for this hour.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "chase_barks_this_hour",
          "legendFormat": "this hour",
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "chase_typical_barks_this_hour",
          "legendFormat": "typical",
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Today vs. 30-day average",
      "description": "Percent above (or below) the average day, with today's raw count.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "(chase_barks_today / clamp_min(chase_daily_average_barks, 1) - 1) * 100",
          "legendFormat": "vs avg",
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "chase_barks_today",
          "legendFormat": "barks today",
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Episodes in current window",
      "description": "Episodes (10+ min) in the current 24 h violation window.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "chase_episodes_in_window",
          "legendFormat": "episodes",
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "chase_episodes_per_window",
          "legendFormat": "needed for violation",
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Barks per hour, last 24 h",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 9
      },
      "timeFrom": "24h",
      "interval": "1h",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "increase(chase_barks_total[1h])",
          "legendFormat": "barks",
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "chase_typical_barks_this_hour",
          "legendFormat": "30-day avg for that hour",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "30-day avg for that hour"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Recent episodes (10+ min)",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 9
      },
      "timeFrom": "14d",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "expr": "{container=\"listener\", event=\"episode\"} | json"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json"
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "start": true,
              "duration_seconds": true,
              "bark_count_estimated": true,
              "violation_id": true
            },
            "renameByName": {
              "start": "When",
              "duration_seconds": "Length (s)",
              "bark_count_estimated": "Est. barks",
              "violation_id": "Violation (report triggered)"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "state-timeline",
      "title": "Barking timeline, today",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 5
      },
      "timeFrom": "now/d",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "chase_barking_now",
          "legendFormat": "barking",
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "chase_in_episode",
          "legendFormat": "episode",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "quiet",
                  "color": "transparent"
                },
                "1": {
                  "text": "barking",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "When does it bark? (avg barks by weekday \u00d7 hour, last 30 days)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "chase_heatmap_barks",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "hour",
                "destinationType": "number"
              },
              {
                "targetField": "weekday",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "hour",
            "rowField": "weekday",
            "valueField": "Value"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "custom": {
            "cellOptions": {
              "type": "color-background",
              "mode": "gradient"
            },
            "align": "center"
          },
          "color": {
            "mode": "continuous-YlRd"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "weekday\\hour"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Mon"
                      },
                      "1": {
                        "text": "Tue"
                      },
                      "2": {
                        "text": "Wed"
                      },
                      "3": {
                        "text": "Thu"
                      },
                      "4": {
                        "text": "Fri"
                      },
                      "5": {
                        "text": "Sat"
                      },
                      "6": {
                        "text": "Sun"
                      }
                    }
                  }
                ]
              },
              {
                "id": "displayName",
                "value": "day / hour"
              }
            ]
          }
        ]
      }
    }
  ]
}