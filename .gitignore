# secrets & personal config — never commit
secrets/*
!secrets/.gitkeep
.env
*.env
*-key.json
*.key.json
config/chase.yaml
terraform.tfvars
infra/envs/*/terraform.tfvars
.terraform/
*.tfstate*

# audio, data, reports
*.wav
*.flac
*.mp3
*.sqlite
*.db
data/
reports/
*.pdf

# tooling
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
.superpowers/

# test artifacts
.coverage
.coverage.*
htmlcov/

# synthetic test fixtures (generated by listener/tests/test_contract.py) are committed
!report/tests/fixtures/**/*.flac

# rendered sample report from synthetic fixtures (no personal data)
!docs/samples/*.pdf
